{
  "name": "@grenz/proxy",
  "version": "0.3.0",
  "description": "The Grenz proxy: policy-enforced credential gateway for AI agents.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "grenz": "./src/index.ts"
  },
  "scripts": {
    "build": "bun run verify:wasm && bun build ./src/index.ts --compile --outfile ./dist/grenz",
    "start": "bun run ./src/index.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "verify:wasm": "bun run ./scripts/verify-wasm.ts"
  },
  "dependencies": {
    "age-encryption": "^0.3.0",
    "web-tree-sitter": "0.27.0",
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "typescript": "^5.5.0"
  }
}
